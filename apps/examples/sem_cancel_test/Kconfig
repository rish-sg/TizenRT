#
# For a description of the syntax of this configuration file,
# see kconfig-language at https://www.kernel.org/doc/Documentation/kbuild/kconfig-language.txt
#

config EXAMPLES_SEM_CANCEL_TEST
	bool "Semaphore cancellation test"
	default n
	depends on !DISABLE_PTHREAD
	---help---
		Enable test for pthread cancellation while blocked in sem_wait().
		Verifies that ECANCELED is not returned from sem_wait() (POSIX compliance)
		and that cleanup handlers are called correctly.

if EXAMPLES_SEM_CANCEL_TEST

config EXAMPLES_SEM_CANCEL_TEST_STACKSIZE
	int "Test thread stack size"
	default 8192
	---help---
		Size of the stack used to create test threads. Default is 8192.

endif # EXAMPLES_SEM_CANCEL_TEST
